<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="hotel_room">

    <include>
      <uri>model://ground_plane</uri>
    </include>
    <include>
      <uri>model://sun</uri>
    </include>

    <!--
      Thesis 4.3.2 describes a "hotel conference room" test map with
      tables placed as obstacles. Thesis table (4.1/4.2) gives a map of
      15 x 13 cells at 0.01 m/cell, which works out far too small for a
      0.5 m robot, so it looks like a units slip in the original text.
      This world instead builds a room roughly matching the *description*
      (a conference room with a few tables) at a reasonable real-world
      scale (~6m x 5m). Resize the walls/tables below if you have the
      actual dimensions.
    -->

    <!-- Outer walls -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>0 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6 0.1 1</size></box></geometry>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>3 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 0.1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 0.1 1</size></box></geometry>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 0.5 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>5 0.1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>5 0.1 1</size></box></geometry>
        </visual>
      </link>
    </model>

    <!-- "Conference tables" as box obstacles -->
    <model name="table_1">
      <static>true</static>
      <pose>1.2 0.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.7 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.7 0.8</size></box></geometry>
        </visual>
      </link>
    </model>
    <model name="table_2">
      <static>true</static>
      <pose>-1.0 -0.9 0.4 0 0 0.4</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.2 0.7 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.7 0.8</size></box></geometry>
        </visual>
      </link>
    </model>
    <model name="table_3">
      <static>true</static>
      <pose>0 1.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 0.6 0.8</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.6 0.8</size></box></geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
