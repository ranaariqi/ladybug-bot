Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
    - Class: rviz/TF
      Name: TF
      Enabled: true
  Global Options:
    Fixed Frame: base_footprint
  Value: true
Window Geometry:
  Height: 800
  Width: 1200
